# URL pública del buscador de jurisprudencia (sin slash final).
# Ejemplo: https://buscador.tudominio.com
BUSCADOR_API_URL=

# Token bearer que el Custom GPT debe enviar en cada request.
# Generá uno con: openssl rand -hex 32
ACTION_API_KEY=

# Puerto local del proxy (opcional, default 8080).
PORT=8080
